<Window x:Class="Gestion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Gestión Médica"
        Height="460" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1923">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0D1F30"/>
                                <Setter Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A2633"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Barra lateral decorativa -->
        <Rectangle Width="4" HorizontalAlignment="Left" Fill="#1565C0"/>

        <!-- Línea inferior decorativa -->
        <Rectangle Height="3" VerticalAlignment="Bottom" Fill="#1565C0" Opacity="0.4"/>

        <StackPanel Margin="50,0,50,0" VerticalAlignment="Center">

            <!-- Logo / Ícono decorativo -->
            <Border Width="64" Height="64"
                    Background="#1A2633"
                    CornerRadius="32"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <TextBlock Text="✚"
                           Foreground="#4FC3F7"
                           FontSize="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <!-- Título -->
            <TextBlock Text="GESTIÓN"
                       Foreground="#4FC3F7"
                       FontSize="22"
                       FontFamily="Segoe UI Light"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="MÉDICA"
                       Foreground="#E8F0F7"
                       FontSize="22"
                       FontFamily="Segoe UI SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,-4,0,0"/>

            <!-- Separador -->
            <Rectangle Height="1" Fill="#1A2633" Margin="0,20,0,28"/>

            <!-- Subtítulo -->
            <TextBlock Text="Bienvenido al sistema de gestión médica."
                       Foreground="#90A4B4"
                       FontSize="13"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <TextBlock Text="Inicia sesión o crea una cuenta para continuar."
                       Foreground="#3A5470"
                       FontSize="11"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Botón Iniciar Sesión -->
            <Button Content="INICIAR SESIÓN"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,12"
                    Click="BtnIrLogin_Click"/>

            <!-- Botón Crear Cuenta -->
            <Button Content="CREAR CUENTA NUEVA"
                    Style="{StaticResource OutlineButton}"
                    Click="BtnIrRegistro_Click"/>

            <!-- Footer -->
            <TextBlock Text="Solo personal y pacientes autorizados"
                       Foreground="#2A3F55"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,28,0,0"/>
        </StackPanel>
    </Grid>
</Window>
