<Window x:Class="Gestion.Views.UsuarioView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mi Panel � Paciente"
        Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2633"/>
                                <Setter Property="Foreground" Value="#E8F0F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A2633"/>
                                <Setter Property="Foreground" Value="#3A5470"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#B71C1C"/>
        </Style>

        <!-- Estilo global para ComboBoxItem oscuro -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="Padding"    Value="10,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2633"/>
                    <Setter Property="Foreground" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0A1520">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <TextBlock Text="GESTI�N" Foreground="#4FC3F7" FontSize="18" FontFamily="Segoe UI Light"/>
                    <TextBlock Text="M�DICA"  Foreground="#E8F0F7" FontSize="18" FontFamily="Segoe UI SemiBold" Margin="0,-4,0,0"/>
                    <Rectangle Height="1" Fill="#1A2633" Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Text="P A C I E N T E"
                           Foreground="#3A5470" FontSize="9" FontFamily="Segoe UI" Margin="20,0,0,12"/>

                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnNavMisCitas" Content="?  Mis Citas"
                            Style="{StaticResource ActiveSidebarButton}" Click="NavMisCitas_Click"/>
                    <Button Content="?  Buscar Cita"
                            Style="{StaticResource SidebarButton}" Click="NavBuscarCita_Click"/>
                    <Button Content="?  Estado de Cita"
                            Style="{StaticResource SidebarButton}" Click="NavEstado_Click"/>
                    <Button Content="?  Mis Facturas"
                            Style="{StaticResource SidebarButton}" Click="NavFacturas_Click"/>
                    <Button Content="?  Estad�sticas"
                            Style="{StaticResource SidebarButton}" Click="NavEstadisticas_Click"/>
                    <Button Content="?  Cancelar Cita"
                            Style="{StaticResource SidebarButton}" Foreground="#EF9A9A" Click="NavCancelar_Click"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Cerrar sesi�n"
                        Style="{StaticResource SidebarButton}" Foreground="#3A5470"
                        Margin="0,0,0,16" Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0A1520" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="TxtPageTitle" Text="Mis Citas"
                               Foreground="#E8F0F7" FontSize="16" FontFamily="Segoe UI Light"
                               VerticalAlignment="Center"/>
                    <!-- Oculto: el ID se asigna desde code-behind usando _usuarioActual -->
                    <TextBox x:Name="TxtMiUsuarioId" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: MIS CITAS                   -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelMisCitas">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="MIS CITAS ASIGNADAS"
                                           Foreground="#4FC3F7" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,14"/>
                                <Button Content="Actualizar lista"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"
                                        Click="BtnMisCitas_Click"/>
                                <Border Background="#0F1923" CornerRadius="4">
                                    <StackPanel>
                                        <ListView x:Name="LvMisCitas"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="#E8F0F7" FontFamily="Segoe UI" FontSize="13"
                                                  SelectionChanged="LvMisCitas_SelectionChanged">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="ID"           Width="50"  DisplayMemberBinding="{Binding Id}"/>
                                                    <GridViewColumn Header="Fecha y Hora" Width="160" DisplayMemberBinding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}"/>
                                                    <GridViewColumn Header="Especialidad" Width="150" DisplayMemberBinding="{Binding IdEspecialidad}"/>
                                                    <GridViewColumn Header="Estado"       Width="120" DisplayMemberBinding="{Binding EstadoTexto}"/>
                                                    <GridViewColumn Header="Precio"       Width="100" DisplayMemberBinding="{Binding Precio, StringFormat=\{0:C0\}}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <TextBlock x:Name="TxtSinCitas"
                                                   Text="No tienes citas asignadas"
                                                   Foreground="#3A5470" FontSize="12" FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center" Padding="20"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PanelDetalleCita"
                                        Background="#0F1923"
                                        CornerRadius="4"
                                        Padding="16"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="INFORMACI�N DE LA CITA M�DICA"
                                                   Foreground="#4FC3F7"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="ID DE CITA" Style="{StaticResource FormLabel}"/>
                                                <TextBlock x:Name="TxtDetalleCitaId"
                                                           Foreground="#E8F0F7"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="FECHA Y HORA" Style="{StaticResource FormLabel}"/>
                                                <TextBlock x:Name="TxtDetalleCitaFecha"
                                                           Foreground="#E8F0F7"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ESPECIALIDAD" Style="{StaticResource FormLabel}"/>
                                                <TextBlock x:Name="TxtDetalleCitaEspecialidad"
                                                           Foreground="#E8F0F7"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="ESTADO" Style="{StaticResource FormLabel}"/>
                                                <TextBlock x:Name="TxtDetalleCitaEstado"
                                                           Foreground="#4FC3F7"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI SemiBold"
                                                           Margin="0,0,0,12"/>
                                                <TextBlock Text="PRECIO" Style="{StaticResource FormLabel}"/>
                                                <TextBlock x:Name="TxtDetalleCitaPrecio"
                                                           Foreground="#E8F0F7"
                                                           FontSize="14"
                                                           FontFamily="Segoe UI"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: BUSCAR Y AGENDAR CITA       -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelBuscarCita" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="BUSCAR Y AGENDAR CITA"
                                           Foreground="#4FC3F7" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,14"/>

                                <!-- 1. ESPECIALIDAD -->
                                <TextBlock Text="ESPECIALIDAD" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CmbEspecialidad"
                                          Style="{StaticResource FormCombo}"
                                          Margin="0,0,0,14"
                                          SelectionChanged="CmbEspecialidad_SelectionChanged">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="Cardiolog�a"/>
                                    <ComboBoxItem Content="Dermatolog�a"/>
                                    <ComboBoxItem Content="Oftalmolog�a"/>
                                    <ComboBoxItem Content="Ortopedia"/>
                                    <ComboBoxItem Content="Pediatr�a"/>
                                    <ComboBoxItem Content="Neurolog�a"/>
                                    <ComboBoxItem Content="Medicina General"/>
                                </ComboBox>

                                <!-- 2. PRECIO (men� desplegable, cargado din�micamente) -->
                                <TextBlock Text="PRECIO DE LA CONSULTA" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CmbPrecioCita"
                                          Style="{StaticResource FormCombo}"
                                          Margin="0,0,0,4"
                                          IsEnabled="False">
                                    <!-- Los �tems se agregan desde CmbEspecialidad_SelectionChanged -->
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                                    </ComboBox.Resources>
                                </ComboBox>
                                <TextBlock x:Name="TxtNotaPrecio"
                                           Text="Selecciona primero una especialidad para ver las tarifas."
                                           Foreground="#3A5470" FontSize="11" FontFamily="Segoe UI"
                                           Margin="0,0,0,14" TextWrapping="Wrap"/>

                                <!-- 3. FECHA -->
                                <TextBlock Text="FECHA" Style="{StaticResource FormLabel}"/>
                                <DatePicker x:Name="DpFechaCita"
                                            Height="38" Margin="0,0,0,14"
                                            FontSize="13" FontFamily="Segoe UI"
                                            Background="#0F1923" Foreground="#E8F0F7"
                                            BorderBrush="#2A3F55" BorderThickness="1"/>

                                <!-- 4. HORA -->
                                <TextBlock Text="HORA" Style="{StaticResource FormLabel}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbHora" Grid.Column="0" Height="38"
                                              Background="#0F1923" Foreground="#E8F0F7"
                                              BorderBrush="#2A3F55" BorderThickness="1"
                                              FontSize="13" FontFamily="Segoe UI">
                                        <ComboBox.Resources>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="07:00"/>
                                        <ComboBoxItem Content="08:00"/>
                                        <ComboBoxItem Content="09:00"/>
                                        <ComboBoxItem Content="10:00"/>
                                        <ComboBoxItem Content="11:00"/>
                                        <ComboBoxItem Content="12:00"/>
                                        <ComboBoxItem Content="13:00"/>
                                        <ComboBoxItem Content="14:00"/>
                                        <ComboBoxItem Content="15:00"/>
                                        <ComboBoxItem Content="16:00"/>
                                        <ComboBoxItem Content="17:00"/>
                                    </ComboBox>
                                    <TextBlock Grid.Column="1" Text=":"
                                               Foreground="#90A4B4" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CmbMinutos" Grid.Column="2" Height="38"
                                              Background="#0F1923" Foreground="#E8F0F7"
                                              BorderBrush="#2A3F55" BorderThickness="1"
                                              FontSize="13" FontFamily="Segoe UI">
                                        <ComboBox.Resources>
                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboItem}"/>
                                        </ComboBox.Resources>
                                        <ComboBoxItem Content="00"/>
                                        <ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="30"/>
                                        <ComboBoxItem Content="45"/>
                                    </ComboBox>
                                </Grid>

                                <Button Content="Verificar disponibilidad y agendar"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"
                                        Click="BtnBuscarCita_Click"/>

                                <TextBlock x:Name="TxtMsgBuscarCita"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: MIS FACTURAS                -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelFacturas" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="MIS FACTURAS"
                                           Foreground="#4FC3F7" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,14"/>
                                <Button Content="Cargar mis facturas"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"
                                        Click="BtnMisFacturas_Click"/>
                                <Border Background="#0F1923" CornerRadius="4" Margin="0,0,0,14">
                                    <DataGrid x:Name="LvFacturas"
                                              Background="Transparent" BorderThickness="0"
                                              Foreground="#E8F0F7" FontFamily="Segoe UI" FontSize="13"
                                              RowBackground="#0F1923" AlternatingRowBackground="#111E2A"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A2633"
                                              HeadersVisibility="Column" AutoGenerateColumns="False"
                                              IsReadOnly="True" SelectionMode="Single" MinHeight="80">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#0A1520"/>
                                                <Setter Property="Foreground" Value="#90A4B4"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="FontFamily" Value="Segoe UI"/>
                                                <Setter Property="Padding" Value="10,8"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="#E8F0F7"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="8,6"/>
                                            </Style>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Foreground" Value="#E8F0F7"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#1A3350"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID"     Width="50"  Binding="{Binding Id}"/>
                                            <DataGridTextColumn Header="Fecha"  Width="150" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}"/>
                                            <DataGridTextColumn Header="Total"  Width="120" Binding="{Binding Total, StringFormat=\{0:C\}}"/>
                                            <DataGridTextColumn Header="Estado" Width="120" Binding="{Binding Estado}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <Button x:Name="BtnGenerarPdf"
                                        Content="Descargar PDF de factura seleccionada"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Click="BtnGenerarPdf_Click"/>
                                <TextBlock x:Name="TxtSinFacturas"
                                           Text="No tienes facturas registradas"
                                           Foreground="#3A5470" FontSize="12" FontFamily="Segoe UI"
                                           HorizontalAlignment="Center" Padding="20" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtMsgFactura"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: ESTADO DE CITA              -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelEstado" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ESTADO DE MI CITA"
                                           Foreground="#4FC3F7" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtEstadoCitaId"
                                             Style="{StaticResource FormInput}"
                                             ToolTip="ID de la cita" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Consultar"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnEstadoCita_Click"/>
                                </Grid>
                                <Border x:Name="PanelResultadoEstado"
                                        Background="#0F1923" CornerRadius="4"
                                        Padding="16" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="Estado: " Foreground="#90A4B4"
                                                   FontSize="14" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                        <Border Background="#1565C0" CornerRadius="12"
                                                Padding="14,6" Margin="10,0,0,0">
                                            <TextBlock x:Name="TxtEstadoValor"
                                                       Foreground="White" FontSize="14"
                                                       FontFamily="Segoe UI SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: ESTAD�STICAS                -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelEstadisticas" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ESTAD�STICAS GENERALES"
                                           Foreground="#4FC3F7" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,14"/>
                                <Button Content="Actualizar estad�sticas"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,16"
                                        Click="BtnPromedioCitas_Click"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="PanelPromedio"
                                            Background="#0F1923" CornerRadius="4"
                                            Padding="20" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PROMEDIO GENERAL"
                                                       Foreground="#90A4B4" FontSize="10" FontFamily="Segoe UI"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtPromedioValor"
                                                       Foreground="#4FC3F7" FontSize="42"
                                                       FontFamily="Segoe UI Light" HorizontalAlignment="Center"/>
                                            <TextBlock Text="citas por paciente" Foreground="#3A5470"
                                                       FontSize="12" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="PanelEstadosCitas"
                                            Grid.Column="2"
                                            Background="#0F1923" CornerRadius="4"
                                            Padding="20" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="CITAS CANCELADAS"
                                                       Foreground="#90A4B4" FontSize="10"
                                                       FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                            <TextBlock x:Name="TxtCanceladasResumen"
                                                       Foreground="#E8F0F7" FontSize="14"
                                                       FontFamily="Segoe UI SemiBold" Margin="0,0,0,10"/>
                                            <ProgressBar x:Name="BarraCanceladas"
                                                         Minimum="0" Maximum="100" Height="14"
                                                         Foreground="#EF5350" Background="#1A2633"
                                                         BorderThickness="0" Margin="0,0,0,18"/>

                                            <UniformGrid Columns="4">
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Pendientes" Foreground="#90A4B4" FontSize="11" FontFamily="Segoe UI"/>
                                                    <TextBlock x:Name="TxtPendientesValor" Foreground="#FFD54F" FontSize="22" FontFamily="Segoe UI Light"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Confirmadas" Foreground="#90A4B4" FontSize="11" FontFamily="Segoe UI"/>
                                                    <TextBlock x:Name="TxtConfirmadasValor" Foreground="#4FC3F7" FontSize="22" FontFamily="Segoe UI Light"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="Canceladas" Foreground="#90A4B4" FontSize="11" FontFamily="Segoe UI"/>
                                                    <TextBlock x:Name="TxtCanceladasValor" Foreground="#EF5350" FontSize="22" FontFamily="Segoe UI Light"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Completadas" Foreground="#90A4B4" FontSize="11" FontFamily="Segoe UI"/>
                                                    <TextBlock x:Name="TxtCompletadasValor" Foreground="#66BB6A" FontSize="22" FontFamily="Segoe UI Light"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Text="CITAS CANCELADAS"
                                                       Foreground="#90A4B4" FontSize="10"
                                                       FontFamily="Segoe UI" Margin="0,18,0,8"/>
                                            <ListView x:Name="LvCitasCanceladas"
                                                      Background="#0A1520" BorderThickness="0"
                                                      Foreground="#E8F0F7" FontFamily="Segoe UI"
                                                      FontSize="12" MaxHeight="130">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="ID" Width="50" DisplayMemberBinding="{Binding Id}"/>
                                                        <GridViewColumn Header="Fecha" Width="140" DisplayMemberBinding="{Binding FechaHora}"/>
                                                        <GridViewColumn Header="Especialidad" Width="130" DisplayMemberBinding="{Binding IdEspecialidad}"/>
                                                        <GridViewColumn Header="Precio" Width="90" DisplayMemberBinding="{Binding Precio, StringFormat=\{0:C0\}}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                            <TextBlock x:Name="TxtSinCanceladas"
                                                       Text="No tienes citas canceladas."
                                                       Foreground="#3A5470" FontSize="12"
                                                       FontFamily="Segoe UI" Padding="0,10,0,0"
                                                       Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================= -->
                    <!-- PANEL: CANCELAR CITA               -->
                    <!-- ======================================= -->
                    <StackPanel x:Name="PanelCancelar" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CANCELAR CITA"
                                           Foreground="#EF5350" FontSize="10"
                                           FontFamily="Segoe UI SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Esta acci�n no se puede deshacer. Solo cancela si est�s seguro."
                                           Foreground="#90A4B4" FontSize="12" FontFamily="Segoe UI"
                                           Margin="0,0,0,16" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtCancelarCitaId"
                                             Style="{StaticResource FormInput}"
                                             ToolTip="ID de la cita a cancelar" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="Cancelar Cita"
                                            Style="{StaticResource DangerButton}"
                                            Click="BtnCancelarCita_Click"/>
                                </Grid>
                                <TextBlock x:Name="TxtMsgCancelar"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Margin="0,10,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

