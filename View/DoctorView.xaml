<Window x:Class="Gestion.Views.DoctorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel del Doctor"
        Height="660" Width="940"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923">

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2633"/>
                                <Setter Property="Foreground" Value="#E8F0F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2E7D32"/>
        </Style>

        <Style x:Key="GridHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0A1520">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <TextBlock Text="GESTIÓN"
                               Foreground="#4FC3F7"
                               FontSize="18"
                               FontFamily="Segoe UI Light"/>
                    <TextBlock Text="MÉDICA"
                               Foreground="#E8F0F7"
                               FontSize="18"
                               FontFamily="Segoe UI SemiBold"
                               Margin="0,-4,0,0"/>
                    <Rectangle Height="1" Fill="#1A2633" Margin="0,16,0,0"/>
                </StackPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="DOCTOR"
                           Foreground="#3A5470"
                           FontSize="9"
                           FontFamily="Segoe UI"
                           Margin="20,0,0,12"/>

                <StackPanel DockPanel.Dock="Top">
                    <Button Content="▪  Pacientes"
                            Style="{StaticResource ActiveSidebarButton}"
                            Click="NavPacientes_Click"/>
                    <Button Content="▪  Historial Clínico"
                            Style="{StaticResource SidebarButton}"
                            Click="NavHistorial_Click"/>
                    <Button Content="▪  Programar Cita"
                            Style="{StaticResource SidebarButton}"
                            Click="NavProgramar_Click"/>
                    <Button Content="▪  Actualizar Cita"
                            Style="{StaticResource SidebarButton}"
                            Click="NavActualizar_Click"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom"
                        Content="Cerrar sesión"
                        Style="{StaticResource SidebarButton}"
                        Foreground="#EF5350"
                        Margin="0,0,0,16"
                        Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="#0A1520" Padding="24,0">
                <TextBlock x:Name="TxtPageTitle"
                           Text="Pacientes"
                           Foreground="#E8F0F7"
                           FontSize="15"
                           FontFamily="Segoe UI SemiBold"
                           VerticalAlignment="Center"/>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel Margin="0,0,0,24">

                    <!-- === PANEL: BUSCAR PACIENTE === -->
                    <StackPanel x:Name="PanelPacientes">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="DATOS DEL PACIENTE"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBuscarPacienteNombre"
                                             Style="{StaticResource FormInput}"
                                             Margin="0,0,10,0"
                                             ToolTip="Nombre, apellido o correo del paciente"/>
                                    <Button Grid.Column="1"
                                            Content="Buscar"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnBuscarPacientes_Click"/>
                                </Grid>
                                <DataGrid x:Name="DgPacientes"
                                          Background="#0F1923"
                                          BorderThickness="0"
                                          Foreground="#E8F0F7"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          RowBackground="#0F1923"
                                          AlternatingRowBackground="#111E2A"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1A2633"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MinHeight="190">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#0A1520"/>
                                            <Setter Property="Foreground" Value="#90A4B4"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#E8F0F7"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nombre" Width="150" Binding="{Binding Nombre}"/>
                                        <DataGridTextColumn Header="Apellido" Width="150" Binding="{Binding Apellido}"/>
                                        <DataGridTextColumn Header="Correo" Width="*" Binding="{Binding Correo}"/>
                                        <DataGridTextColumn Header="Teléfono" Width="115" Binding="{Binding Telefono}"/>
                                        <DataGridTemplateColumn Header="" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Ver datos"
                                                            Style="{StaticResource ActionButton}"
                                                            Height="30"
                                                            Padding="10,0"
                                                            Click="BtnDatosPaciente_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtSinPacientes"
                                           Text="No hay pacientes registrados con ese nombre."
                                           Foreground="#3A5470"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           Padding="16"
                                           Visibility="Collapsed"/>
                                <Border x:Name="PanelDatosPaciente"
                                        Background="#0F1923"
                                        CornerRadius="4"
                                        Padding="16"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                                            <TextBlock x:Name="TxtPacienteNombre"
                                                       Foreground="#E8F0F7"
                                                       FontSize="14"
                                                       FontFamily="Segoe UI"
                                                       Margin="0,0,0,12"/>
                                            <TextBlock Text="CORREO" Style="{StaticResource FormLabel}"/>
                                            <TextBlock x:Name="TxtPacienteCorreo"
                                                       Foreground="#E8F0F7"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="TELÉFONO" Style="{StaticResource FormLabel}"/>
                                            <TextBlock x:Name="TxtPacienteTelefono"
                                                       Foreground="#E8F0F7"
                                                       FontSize="13"
                                                       FontFamily="Segoe UI"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="PanelCitasPaciente"
                                        Background="#0F1923"
                                        CornerRadius="4"
                                        Padding="16"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="CITAS MÉDICAS ASIGNADAS"
                                                   Foreground="#4FC3F7"
                                                   FontSize="10"
                                                   FontFamily="Segoe UI SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <DataGrid x:Name="DgCitasPaciente"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#E8F0F7"
                                                  FontFamily="Segoe UI"
                                                  FontSize="13"
                                                  RowBackground="#0F1923"
                                                  AlternatingRowBackground="#111E2A"
                                                  GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#1A2633"
                                                  HeadersVisibility="Column"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  MinHeight="140">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#0A1520"/>
                                                    <Setter Property="Foreground" Value="#90A4B4"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="FontFamily" Value="Segoe UI"/>
                                                    <Setter Property="Padding" Value="10,8"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="Foreground" Value="#E8F0F7"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Fecha y Hora" Width="160" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}"/>
                                                <DataGridTextColumn Header="Especialidad" Width="150" Binding="{Binding IdEspecialidad}"/>
                                                <DataGridTextColumn Header="Estado" Width="120" Binding="{Binding EstadoTexto}"/>
                                                <DataGridTextColumn Header="Precio" Width="100" Binding="{Binding Precio, StringFormat=\{0:C0\}}"/>
                                                <DataGridTemplateColumn Header="" Width="130">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Completar"
                                                                    Style="{StaticResource ActionButton}"
                                                                    Height="30"
                                                                    Padding="10,0"
                                                                    Click="BtnCompletarCitaPaciente_Click"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="TxtSinCitasPaciente"
                                                   Text="Este paciente no tiene citas asignadas."
                                                   Foreground="#3A5470"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center"
                                                   Padding="16"
                                                   Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtMsgCitasPaciente"
                                                   Foreground="#66BB6A"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   Margin="0,8,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: HISTORIAL CLÍNICO === -->
                    <StackPanel x:Name="PanelHistorial" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="HISTORIAL CLÍNICO DEL PACIENTE"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtHistorialPacienteId"
                                             Style="{StaticResource FormInput}"
                                             Margin="0,0,10,0"
                                             ToolTip="ID del paciente"/>
                                    <Button Grid.Column="1"
                                            Content="Cargar"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnCargarHistorial_Click"/>
                                </Grid>
                                <!-- Tabla historial -->
                                <Border Background="#0F1923" CornerRadius="4" Padding="0">
                                    <!-- Encabezado tabla -->
                                    <StackPanel>
                                        <Grid Background="#0A1520">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource GridHeader}"/>
                                            <TextBlock Grid.Column="1" Text="FECHA" Style="{StaticResource GridHeader}"/>
                                            <TextBlock Grid.Column="2" Text="DIAGNÓSTICO" Style="{StaticResource GridHeader}"/>
                                            <TextBlock Grid.Column="3" Text="DOCTOR" Style="{StaticResource GridHeader}"/>
                                        </Grid>
                                        <ListView x:Name="LvHistorial"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Foreground="#E8F0F7"
                                                  FontSize="12"
                                                  FontFamily="Segoe UI"
                                                  MaxHeight="240">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Header="" Width="80"
                                                                    DisplayMemberBinding="{Binding Id}"/>
                                                    <GridViewColumn Header="" Width="140"
                                                                    DisplayMemberBinding="{Binding Fecha}"/>
                                                    <GridViewColumn Header="" Width="260"
                                                                    DisplayMemberBinding="{Binding Diagnostico}"/>
                                                    <GridViewColumn Header="" Width="120"
                                                                    DisplayMemberBinding="{Binding NombreDoctor}"/>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                        <TextBlock x:Name="TxtHistorialVacio"
                                                   Text="Sin registros para este paciente"
                                                   Foreground="#3A5470"
                                                   FontSize="12"
                                                   FontFamily="Segoe UI"
                                                   HorizontalAlignment="Center"
                                                   Padding="20"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Crear nuevo historial clínico -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="NUEVO HISTORIAL CLÍNICO"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ID PACIENTE" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNuevoHistPacienteId"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="FECHA CONSULTA" Style="{StaticResource FormLabel}"/>
                                        <DatePicker x:Name="DpNuevoHistFecha"
                                                    Background="#0F1923"
                                                    Foreground="#E8F0F7"
                                                    BorderBrush="#2A3F55"
                                                    Height="38"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="DIAGNÓSTICO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNuevoHistDiagnostico"
                                                 Background="#0F1923"
                                                 Foreground="#E8F0F7"
                                                 BorderBrush="#2A3F55"
                                                 BorderThickness="1"
                                                 Padding="10,8"
                                                 FontSize="13"
                                                 FontFamily="Segoe UI"
                                                 Height="86"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="TRATAMIENTO" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtNuevoHistTratamiento"
                                         Background="#0F1923"
                                         Foreground="#E8F0F7"
                                         BorderBrush="#2A3F55"
                                         BorderThickness="1"
                                         Padding="10,8"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="NOTAS ADICIONALES" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtNuevoHistNotas"
                                         Background="#0F1923"
                                         Foreground="#E8F0F7"
                                         BorderBrush="#2A3F55"
                                         BorderThickness="1"
                                         Padding="10,8"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,0,0,14"/>
                                <Button Content="Registrar Historial"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right"
                                        Click="BtnCrearHistorial_Click"/>
                                <TextBlock x:Name="TxtMsgNuevoHist"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: PROGRAMAR CITA === -->
                    <StackPanel x:Name="PanelProgramar" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="PROGRAMAR NUEVA CITA"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="ID USUARIO / PACIENTE" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtCitaUsuarioId"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="FECHA Y HORA" Style="{StaticResource FormLabel}"/>
                                        <DatePicker x:Name="DpCitaFecha"
                                                    Background="#0F1923"
                                                    Foreground="#E8F0F7"
                                                    BorderBrush="#2A3F55"
                                                    Height="38"
                                                    Margin="0,0,0,12"/>
                                        <TextBlock Text="ESPECIALIDAD" Style="{StaticResource FormLabel}"/>
                                        <ComboBox x:Name="CbCitaEspecialidad"
                                                  Background="#0F1923"
                                                  Foreground="#E8F0F7"
                                                  BorderBrush="#2A3F55"
                                                  BorderThickness="1"
                                                  Height="38"
                                                  FontSize="13"
                                                  FontFamily="Segoe UI"
                                                  DisplayMemberPath="Nombre"
                                                  SelectedValuePath="Valor"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="MOTIVO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtCitaMotivo"
                                                 Background="#0F1923"
                                                 Foreground="#E8F0F7"
                                                 BorderBrush="#2A3F55"
                                                 BorderThickness="1"
                                                 Padding="10,8"
                                                 FontSize="13"
                                                 FontFamily="Segoe UI"
                                                 Height="86"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Programar Cita"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"
                                        Click="BtnProgramarCita_Click"/>
                                <TextBlock x:Name="TxtMsgCita"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: ACTUALIZAR CITA === -->
                    <StackPanel x:Name="PanelActualizar" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ACTUALIZAR CITA EXISTENTE"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <TextBlock Text="ID DE LA CITA" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtActualizarCitaId"
                                         Style="{StaticResource FormInput}"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="NUEVA FECHA Y HORA" Style="{StaticResource FormLabel}"/>
                                <DatePicker x:Name="DpActualizarFecha"
                                            Background="#0F1923"
                                            Foreground="#E8F0F7"
                                            BorderBrush="#2A3F55"
                                            Height="38"
                                            Margin="0,0,0,12"/>
                                <TextBlock Text="OBSERVACIONES" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtActualizarObservaciones"
                                         Background="#0F1923"
                                         Foreground="#E8F0F7"
                                         BorderBrush="#2A3F55"
                                         BorderThickness="1"
                                         Padding="10,8"
                                         FontSize="13"
                                         FontFamily="Segoe UI"
                                         Height="72"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="0,0,0,14"/>
                                <Button Content="Actualizar Cita"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Right"
                                        Click="BtnActualizarCita_Click"/>
                                <TextBlock x:Name="TxtMsgActualizar"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
