<Window x:Class="Gestion.Views.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Gestión Médica — Crear Cuenta"
        Height="680" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1923">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#4FC3F7"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A2633"/>
                                <Setter Property="Foreground" Value="#3A5470"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   TextDecorations="Underline"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#81D4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Rectangle Width="4" HorizontalAlignment="Left" Fill="#1565C0"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="50,36,50,36">

                <!-- Encabezado -->
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="GESTIÓN MÉDICA"
                               Foreground="#4FC3F7"
                               FontSize="11"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Crear Cuenta"
                               Foreground="#E8F0F7"
                               FontSize="26"
                               FontFamily="Segoe UI Light"/>
                    <Rectangle Height="2" Width="40" Fill="#1565C0"
                               HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Nombre y Apellido en dos columnas -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NOMBRE" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="APELLIDO" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="TxtApellido" Style="{StaticResource InputStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Correo -->
                <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtCorreo"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,14"/>

                <!-- Contraseña -->
                <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="TxtContrasena"
                             Style="{StaticResource PasswordStyle}"
                             Margin="0,0,0,14"/>

                <!-- Confirmar Contraseña -->
                <TextBlock Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
                <PasswordBox x:Name="TxtConfirmarContrasena"
                             Style="{StaticResource PasswordStyle}"
                             Margin="0,0,0,14"/>

                <!-- Teléfono -->
                <TextBlock Text="TELÉFONO (OPCIONAL)" Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="TxtTelefono"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,20"/>

                <!-- Mensaje -->
                <TextBlock x:Name="TxtMensaje"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Visibility="Collapsed"
                           Margin="0,0,0,14"
                           TextWrapping="Wrap"/>

                <!-- Botón registrar -->
                <Button x:Name="BtnRegistrar"
                        Content="CREAR CUENTA"
                        Style="{StaticResource PrimaryButton}"
                        Click="BtnRegistrar_Click"
                        Margin="0,0,0,16"/>

                <!-- Volver al login -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="¿Ya tienes cuenta? "
                               Foreground="#3A5470"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Button Content="Inicia sesión"
                            Style="{StaticResource LinkButton}"
                            Click="BtnIrLogin_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>