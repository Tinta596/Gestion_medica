<Window x:Class="Gestion.Views.AdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Administración"
        Height="660" Width="960"
        WindowStartupLocation="CenterScreen"
        Background="#0F1923">

    <Window.Resources>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A2633"/>
                                <Setter Property="Foreground" Value="#E8F0F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActiveSidebarButton" TargetType="Button" BasedOn="{StaticResource SidebarButton}">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#4FC3F7"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FormInput" TargetType="TextBox">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- ===== COMBOBOX ITEM DARK ===== -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A2633"/>
                    <Setter Property="Foreground" Value="#4FC3F7"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== COMBOBOX DARK (template completo) ===== -->
        <Style x:Key="FormCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MaxDropDownHeight" Value="190"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- ToggleButton cubre TODO el control para abrir el popup -->
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#0F1923"
                                                BorderBrush="#2A3F55"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="28"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="#4FC3F7"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Valor seleccionado, superpuesto sobre el botón -->
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              Margin="10,0,30,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E8F0F7"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <!-- Popup del dropdown -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#0F1923"
                                        BorderBrush="#2A3F55"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True"
                                                  Background="#0F1923">
                                        <StackPanel IsItemsHost="True"
                                                    Background="#0F1923"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#0F1923"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C62828"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== SIDEBAR ===== -->
        <Border Grid.Column="0" Background="#0A1520">
            <DockPanel>
                <!-- Logo / título -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
                    <TextBlock Text="GESTIÓN"
                               Foreground="#4FC3F7"
                               FontSize="18"
                               FontFamily="Segoe UI Light"
                               FontWeight="Light"/>
                    <TextBlock Text="MÉDICA"
                               Foreground="#E8F0F7"
                               FontSize="18"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               Margin="0,-4,0,0"/>
                    <Rectangle Height="1" Fill="#1A2633" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Rol -->
                <TextBlock DockPanel.Dock="Top"
                           Text="ADMINISTRADOR"
                           Foreground="#3A5470"
                           FontSize="9"
                           FontFamily="Segoe UI"
                           Margin="20,0,0,12"/>

                <!-- Menú -->
                <StackPanel DockPanel.Dock="Top">
                    <Button Content="▪  Usuarios"
                            Style="{StaticResource ActiveSidebarButton}"
                            Click="NavUsuarios_Click"/>
                    <Button Content="▪  Doctores"
                            Style="{StaticResource SidebarButton}"
                            Click="NavDoctores_Click"/>
                    <Button Content="▪  Disponibilidad"
                            Style="{StaticResource SidebarButton}"
                            Click="NavDisponibilidad_Click"/>
                    <Button Content="▪  Citas"
                            Style="{StaticResource SidebarButton}"
                            Click="NavCitas_Click"/>
                    <Button Content="▪  Correos"
                            Style="{StaticResource SidebarButton}"
                            Click="NavCorreos_Click"/>
                </StackPanel>

                <!-- Cerrar sesión -->
                <Button DockPanel.Dock="Bottom"
                        Content="Cerrar sesión"
                        Style="{StaticResource SidebarButton}"
                        Foreground="#EF5350"
                        Margin="0,0,0,16"
                        Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="#0A1520" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="TxtPageTitle"
                               Text="Gestión de Usuarios"
                               Foreground="#E8F0F7"
                               FontSize="15"
                               FontFamily="Segoe UI SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtAdminName"
                               Text="Admin"
                               Foreground="#90A4B4"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>

            <!-- Área de contenido con scroll -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel x:Name="ContentPanel" Margin="0,0,0,24">

                    <!-- === PANEL: GESTIÓN DE USUARIOS === -->
                    <StackPanel x:Name="PanelUsuarios">

                        <!-- Buscar usuario -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="BUSCAR DOCTOR O PACIENTE"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBuscarId"
                                             Style="{StaticResource FormInput}"
                                             Margin="0,0,10,0"
                                             ToolTip="Nombre, apellido o correo"/>
                                    <Button Grid.Column="1"
                                            Content="Buscar"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnBuscarUsuario_Click"/>
                                </Grid>
                                <DataGrid x:Name="DgUsuariosAdmin"
                                          Background="#0F1923"
                                          BorderThickness="0"
                                          Foreground="#E8F0F7"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          RowBackground="#0F1923"
                                          AlternatingRowBackground="#111E2A"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1A2633"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MinHeight="180">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#0A1520"/>
                                            <Setter Property="Foreground" Value="#90A4B4"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#E8F0F7"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Width="55" Binding="{Binding Id}"/>
                                        <DataGridTextColumn Header="Nombre" Width="140" Binding="{Binding Nombre}"/>
                                        <DataGridTextColumn Header="Apellido" Width="140" Binding="{Binding Apellido}"/>
                                        <DataGridTextColumn Header="Rol" Width="95" Binding="{Binding RolTexto}"/>
                                        <DataGridTextColumn Header="Correo" Width="*" Binding="{Binding Correo}"/>
                                        <DataGridTemplateColumn Header="" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Ver"
                                                            Style="{StaticResource ActionButton}"
                                                            Height="30"
                                                            Padding="10,0"
                                                            Click="BtnVerUsuarioAdmin_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtSinUsuariosAdmin"
                                           Text="No se encontraron doctores o pacientes con ese nombre."
                                           Foreground="#3A5470"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           Padding="16"
                                           Visibility="Collapsed"/>
                                <Border x:Name="PanelResultadoUsuario"
                                        Background="#0F1923"
                                        CornerRadius="4"
                                        Padding="14"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtResultadoUsuario"
                                                   Foreground="#E8F0F7"
                                                   FontSize="13"
                                                   FontFamily="Segoe UI"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Crear usuario -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CREAR USUARIO"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNuevoNombre"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="CORREO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNuevoCorreo"
                                                 Style="{StaticResource FormInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabel}"/>
                                        <PasswordBox x:Name="TxtNuevoPassword"
                                                     Background="#0F1923"
                                                     Foreground="#E8F0F7"
                                                     BorderBrush="#2A3F55"
                                                     BorderThickness="1"
                                                     Padding="10,8"
                                                     FontSize="13"
                                                     Height="38"
                                                     Margin="0,0,0,12"/>
                                        <TextBlock Text="TELÉFONO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtNuevoTelefono"
                                                 Style="{StaticResource FormInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Crear Usuario"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"
                                        Click="BtnCrearUsuario_Click"/>
                                <TextBlock x:Name="TxtMsgCrear"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Desactivar usuario -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DESACTIVAR USUARIO"
                                           Foreground="#EF5350"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDesactivarId"
                                             Style="{StaticResource FormInput}"
                                             Margin="0,0,10,0"
                                             ToolTip="ID del usuario"/>
                                    <Button Grid.Column="1"
                                            Content="Desactivar"
                                            Style="{StaticResource DangerButton}"
                                            Click="BtnDesactivarUsuario_Click"/>
                                </Grid>
                                <TextBlock x:Name="TxtMsgDesactivar"
                                           Foreground="#EF5350"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: DOCTORES === -->
                    <StackPanel x:Name="PanelDoctores" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="INFORME DE DOCTORES"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#0F1923" CornerRadius="4" Padding="16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="DOCTORES ACTIVOS"
                                                       Foreground="#90A4B4"
                                                       FontSize="10"
                                                       FontFamily="Segoe UI"/>
                                            <TextBlock x:Name="TxtTotalDoctores"
                                                       Text="0"
                                                       Foreground="#4FC3F7"
                                                       FontSize="36"
                                                       FontFamily="Segoe UI Light"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Grid.Column="1"
                                            Content="Actualizar informe"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnActualizarDoctores_Click"/>
                                </Grid>
                                <DataGrid x:Name="DgDoctores"
                                          Background="#0F1923"
                                          BorderThickness="0"
                                          Foreground="#E8F0F7"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          RowBackground="#0F1923"
                                          AlternatingRowBackground="#111E2A"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1A2633"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          MinHeight="180">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#0A1520"/>
                                            <Setter Property="Foreground" Value="#90A4B4"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#E8F0F7"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Width="60" Binding="{Binding Id}"/>
                                        <DataGridTextColumn Header="Nombre" Width="160" Binding="{Binding Nombre}"/>
                                        <DataGridTextColumn Header="Apellido" Width="160" Binding="{Binding Apellido}"/>
                                        <DataGridTextColumn Header="Correo" Width="240" Binding="{Binding Correo}"/>
                                        <DataGridTextColumn Header="Activo" Width="80" Binding="{Binding Activo}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtSinDoctores"
                                           Text="No hay doctores activos registrados."
                                           Foreground="#3A5470"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           Padding="20"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CREAR DOCTOR"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="NOMBRE" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtDoctorNombre"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="APELLIDO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtDoctorApellido"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="TELÉFONO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtDoctorTelefono"
                                                 Style="{StaticResource FormInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="CORREO" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtDoctorCorreo"
                                                 Style="{StaticResource FormInput}"
                                                 Margin="0,0,0,12"/>
                                        <TextBlock Text="CONTRASEÑA" Style="{StaticResource FormLabel}"/>
                                        <PasswordBox x:Name="TxtDoctorPassword"
                                                     Background="#0F1923"
                                                     Foreground="#E8F0F7"
                                                     BorderBrush="#2A3F55"
                                                     BorderThickness="1"
                                                     Padding="10,8"
                                                     FontSize="13"
                                                     Height="38"
                                                     Margin="0,0,0,12"/>
                                        <TextBlock Text="DIRECCIÓN" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="TxtDoctorDireccion"
                                                 Style="{StaticResource FormInput}"/>
                                    </StackPanel>
                                </Grid>
                                <Button Content="Crear Doctor"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Right"
                                        Margin="0,14,0,0"
                                        Click="BtnCrearDoctor_Click"/>
                                <TextBlock x:Name="TxtMsgDoctor"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: DISPONIBILIDAD === -->
                    <StackPanel x:Name="PanelDisponibilidad" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="VERIFICAR DISPONIBILIDAD"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <TextBlock Text="FECHA Y HORA" Style="{StaticResource FormLabel}"/>
                                <Grid Margin="0,0,0,12" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="DpFecha"
                                                Style="{StaticResource FormDatePicker}"/>
                                    <ComboBox x:Name="CbHoraDisp"
                                              Grid.Column="2"
                                              Style="{StaticResource FormCombo}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="07"/>
                                        <ComboBoxItem Content="08"/>
                                        <ComboBoxItem Content="09"/>
                                        <ComboBoxItem Content="10"/>
                                        <ComboBoxItem Content="11"/>
                                        <ComboBoxItem Content="12"/>
                                        <ComboBoxItem Content="13"/>
                                        <ComboBoxItem Content="14"/>
                                        <ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="16"/>
                                        <ComboBoxItem Content="17"/>
                                    </ComboBox>
                                    <ComboBox x:Name="CbMinutosDisp"
                                              Grid.Column="4"
                                              Style="{StaticResource FormCombo}"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="00"/>
                                        <ComboBoxItem Content="15"/>
                                        <ComboBoxItem Content="30"/>
                                        <ComboBoxItem Content="45"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock Text="ESPECIALIDAD" Style="{StaticResource FormLabel}"/>
                                <ComboBox x:Name="CbEspecialidad"
                                          Style="{StaticResource FormCombo}"
                                          Width="360"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,14"
                                          SelectedIndex="0">
                                    <ComboBoxItem Content="General"/>
                                    <ComboBoxItem Content="Cardiología"/>
                                    <ComboBoxItem Content="Dermatología"/>
                                    <ComboBoxItem Content="Pediatría"/>
                                    <ComboBoxItem Content="Neurología"/>
                                    <ComboBoxItem Content="Ortopedia"/>
                                    <ComboBoxItem Content="Oftalmología"/>
                                </ComboBox>
                                <Button Content="Verificar Disponibilidad"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Click="BtnVerificarDisp_Click"/>
                                <Border x:Name="PanelResultadoDisp"
                                        Background="#0F1923"
                                        CornerRadius="4"
                                        Padding="14"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TxtResultadoDisp"
                                               Foreground="#66BB6A"
                                               FontSize="13"
                                               FontFamily="Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: CITAS === -->
                    <StackPanel x:Name="PanelCitas" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CITAS MÉDICAS PEDIDAS"
                                               Foreground="#4FC3F7"
                                               FontSize="10"
                                               FontFamily="Segoe UI SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            Content="Refrescar"
                                            Style="{StaticResource ActionButton}"
                                            Click="BtnRefrescarCitas_Click"/>
                                </Grid>
                                <DataGrid x:Name="DgCitas"
                                          Background="#0F1923"
                                          BorderThickness="0"
                                          Foreground="#E8F0F7"
                                          FontFamily="Segoe UI"
                                          FontSize="13"
                                          RowBackground="#0F1923"
                                          AlternatingRowBackground="#111E2A"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#1A2633"
                                          HeadersVisibility="Column"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="260">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#0A1520"/>
                                            <Setter Property="Foreground" Value="#90A4B4"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontFamily" Value="Segoe UI"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#E8F0F7"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID" Width="55" Binding="{Binding Id}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Paciente" Width="*" Binding="{Binding Paciente}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Fecha" Width="140" Binding="{Binding FechaHora, StringFormat=dd/MM/yyyy HH:mm}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Especialidad" Width="130" Binding="{Binding IdEspecialidad}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Precio" Width="90" Binding="{Binding Precio, StringFormat=C0}" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Estado" Width="135">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox Style="{StaticResource FormCombo}"
                                                              SelectedValue="{Binding EstadoTexto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              SelectedValuePath="Content">
                                                        <ComboBoxItem Content="Pendiente"/>
                                                        <ComboBoxItem Content="Confirmada"/>
                                                        <ComboBoxItem Content="Cancelada"/>
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Guardar"
                                                            Style="{StaticResource ActionButton}"
                                                            Height="30"
                                                            Padding="10,0"
                                                            Click="BtnGuardarEstadoCita_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="TxtSinCitasAdmin"
                                           Text="No hay citas médicas pedidas."
                                           Foreground="#3A5470"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           HorizontalAlignment="Center"
                                           Padding="20"
                                           Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtMsgConfirmarCita"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === PANEL: CORREOS === -->
                    <StackPanel x:Name="PanelCorreos" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ENVIAR CONFIRMACIÓN DE CITA"
                                           Foreground="#4FC3F7"
                                           FontSize="10"
                                           FontFamily="Segoe UI SemiBold"
                                           Margin="0,0,0,14"/>
                                <TextBlock Text="CORREO DESTINO" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtCorreoDestino"
                                         Style="{StaticResource FormInput}"
                                         Margin="0,0,0,12"/>
                                <TextBlock Text="ID DE CITA" Style="{StaticResource FormLabel}"/>
                                <TextBox x:Name="TxtIdCitaCorreo"
                                         Style="{StaticResource FormInput}"
                                         Margin="0,0,0,14"/>
                                <Button Content="Enviar Confirmación"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left"
                                        Click="BtnEnviarCorreo_Click"/>
                                <TextBlock x:Name="TxtMsgCorreo"
                                           Foreground="#66BB6A"
                                           FontSize="12"
                                           FontFamily="Segoe UI"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
