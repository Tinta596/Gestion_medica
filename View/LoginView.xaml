<Window x:Class="Gestion.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Gestión Médica — Iniciar Sesión"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0F1923">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#90A4B4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="CaretBrush" Value="#4FC3F7"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A2633"/>
            <Setter Property="Foreground" Value="#E8F0F7"/>
            <Setter Property="BorderBrush" Value="#2A3F55"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="42"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0D47A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Barra lateral decorativa -->
        <Rectangle Width="4" HorizontalAlignment="Left" Fill="#1565C0"/>

        <StackPanel Margin="50,40,50,40" VerticalAlignment="Center">

            <!-- Encabezado -->
            <StackPanel Margin="0,0,0,36">
                <TextBlock Text="GESTIÓN MÉDICA"
                           Foreground="#4FC3F7"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Iniciar Sesión"
                           Foreground="#E8F0F7"
                           FontSize="26"
                           FontFamily="Segoe UI Light"/>
                <Rectangle Height="2" Width="40" Fill="#1565C0"
                           HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>

            <!-- Campo Correo -->
            <TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="TxtCorreo"
                     Style="{StaticResource InputStyle}"
                     Margin="0,0,0,18"
                     Tag="correo@ejemplo.com"/>

            <!-- Campo Contraseña -->
            <TextBlock Text="CONTRASEÑA" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="TxtContrasena"
                         Style="{StaticResource PasswordStyle}"
                         Margin="0,0,0,28"/>

            <!-- Mensaje de error -->
            <TextBlock x:Name="TxtError"
                       Foreground="#EF5350"
                       FontSize="12"
                       FontFamily="Segoe UI"
                       Visibility="Collapsed"
                       Margin="0,0,0,16"
                       TextWrapping="Wrap"/>

            <!-- Botón -->
            <Button x:Name="BtnLogin"
                    Content="INGRESAR AL SISTEMA"
                    Style="{StaticResource PrimaryButton}"
                    Click="BtnLogin_Click"/>

            <!-- Footer -->
            <TextBlock Text="Acceso restringido — Solo personal autorizado"
                       Foreground="#3A4F63"
                       FontSize="10"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,24,0,0"/>
        </StackPanel>
    </Grid>
</Window>
